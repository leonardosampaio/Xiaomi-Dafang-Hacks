server.document-root = "/system/sdcard/www"
server.pid-file = "/run/lighttpd.pid"
server.port = 80
# Don't show the lighttpd version in the "Server" header
server.tag = ""

# uncomment to allow more exotic hostnames e.g. with underscores
#server.http-parseopt-host-strict = "disable"

mimetype.assign = (
  ".html" => "text/html",
  ".txt" => "text/plain",
  ".jpg" => "image/jpeg",
  ".png" => "image/png",
  ".css" => "text/css",
  ".js" => "text/javascript"
)
index-file.names = ( "index.html" )
server.modules = ("mod_access",
		  "mod_alias",
		  "mod_auth",
		  "mod_authn_file",
		  "mod_redirect",
		  "mod_rewrite",
		  "mod_cgi",
		  "mod_fastcgi",
		  "mod_dirlisting",
		  "mod_staticfile",
		  "mod_accesslog",
		  "mod_openssl")

cgi.assign = ( ".cgi" => "/bin/sh" )

#If below 4 lines are commented out then SSL is disabled if un-commented SSL is enabled
#SSL is enabled by default
#If disabling SSL you must clear your site cookie
$SERVER["socket"] == ":443" {
  ssl.engine = "enable"
  ssl.pemfile = "/system/sdcard/config/lighttpd.pem"
}

# Support letsencrypt SSL cert paths
# (we don't want to upgrade to SSL nor auth' this path)
$HTTP["url"] !~ "^/.well-known/(.*)" {

	$HTTP["scheme"] == "https" {
		auth.backend				= "htdigest"
		auth.backend.htdigest.userfile = "/system/sdcard/config/lighttpd.user"
		auth.require = ( "/" => ("method" => "basic", "realm" => "all", "require" => "user=root"))
		alias.url = ( "/viewer" => "/system/sdcard/DCIM/" )
		$HTTP["url"] =~ "^/viewer($|/)" { server.dir-listing = "enable" }
	}

#If below 7 lines are commented out then SSL is disabled if un-commented SSL is enabled
#SSL is enabled by default
#If disabling SSL you must clear your site cookie
	$HTTP["scheme"] == "http" {
		# Do not apply rule to 127.0.0.1, for ssh tunnels
		$HTTP["remote-ip"] != "127.0.0.1" {
			# capture vhost name with regex conditiona -> %0 in redirect pattern
			# must be the most inner block to the redirect rule
			$HTTP["host"] =~ ".*" {
				url.redirect = (".*" => "https://%0$0")
			}
		}
	}
}

# Requests coming through the Cloudflare Tunnel (cloudflared connects from
# 127.0.0.1) always need the tunnel user/password set in the web UI
# (Network services > Cloudflare Tunnel). Do not load mod_extforward: it would
# let clients spoof the remote address with X-Forwarded-For.
$HTTP["remoteip"] == "127.0.0.1" {
	auth.backend = "htdigest"
	auth.backend.htdigest.userfile = "/system/sdcard/config/lighttpd.tunnel.user"
	auth.require = ( "/" => ("method" => "basic", "realm" => "cloudflared", "require" => "valid-user"))
	# Requests with credentials are logged with the client IP for the IP ban
	# (scripts/tunnel-ban.sh): a 401 here is a failed login
	$REQUEST_HEADER["Authorization"] =~ "." {
		accesslog.filename = "/tmp/lighttpd-tunnel-auth.log"
		accesslog.format = "%{CF-Connecting-IP}i %>s"
	}
	# Banned IPs (written by scripts/tunnel-ban.sh)
	include_shell "cat /tmp/lighttpd-tunnel-ban.conf 2>/dev/null || true"
}

## enable debugging
#debug.log-request-header	= "enable"
#debug.log-response-header	= "enable"
#debug.log-request-handling	= "enable"
#debug.log-file-not-found	= "enable"
#debug.log-condition-handling	= "enable"

## where to send error-messages to
server.errorlog			= "/tmp/lighttpd-error.log"

## CGI (etc) stderr log
server.breakagelog		= "/tmp/lighttpd-cgi-stderr.log"

## accesslog module
accesslog.filename		= "/tmp/lighttpd-access.log"
